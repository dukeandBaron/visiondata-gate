# VisionData Gate desktop safe defaults.
# This file is copied to %APPDATA%\VisionData Gate\.env.local on first start.
# Keep external models disabled until a local user explicitly configures them.

VISIONDATA_PRODUCT_MODEL_KEYS_ENABLED=false
VISIONDATA_INCIDENT_MODEL_MODE=off
VISIONDATA_INCIDENT_MODEL_ALLOW_REMOTE=false
VISIONDATA_MULTIMODAL_ADVISOR_MODE=off
VISIONDATA_AGENTTEAMS_WRITE_ENABLED=false

# Optional provider settings belong only in the copied .env.local file.
# Never place real keys in this packaged template or in VITE_* variables.
# VISIONDATA_INCIDENT_MODEL_BASE_URL=
# VISIONDATA_INCIDENT_MODEL_ENDPOINT=
# VISIONDATA_INCIDENT_MODEL_NAME=
# VISIONDATA_INCIDENT_MODEL_ALLOWED_HOSTS=
# VISIONDATA_INCIDENT_MODEL_API_KEY=
