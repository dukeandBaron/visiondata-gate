# VisionData Gate incident EvidenceGap / Counterevidence Planner
# Copy this template to .env.local. run_app.ps1 and run_api.ps1 load that
# ignored local file automatically; this example is never loaded and must never
# contain a real credential.

# Optional OpenToken credential for external UI development tools. It is not
# mapped into either product-runtime reviewer.
VISIONDATA_OPENTOKEN_API_KEY=

VISIONDATA_UI_DEV_BASE_URL=https://gw.opentoken.io
VISIONDATA_UI_DEV_ENDPOINT=
VISIONDATA_UI_DEV_BUILDER_MODEL=gemini-3.7-flash
VISIONDATA_UI_DEV_VISUAL_REVIEW_MODEL=gemini-3.7-flash
VISIONDATA_UI_DEV_ALLOW_REMOTE=false
# Safe public default. Set any nonzero development budget only in .env.local.
VISIONDATA_UI_DEV_MAX_BUDGET_USD=0

# Fail-closed product/runtime credential gate. When false, Key values loaded
# from .env.local are suppressed before run_app.ps1 or run_api.ps1 starts.
VISIONDATA_PRODUCT_MODEL_KEYS_ENABLED=false

# Server-side read-only dataset allowlist.  Required before a browser operator
# may register a local_authorized_directory.  On Windows, separate multiple
# absolute roots with `;`; keep this list narrow and never use a drive root.
VISIONDATA_LOCAL_SOURCE_ALLOW_ROOTS=E:\\authorized-data\\visiondata

# Optional reviewed Rule Pack for ProductService Omni tasks. Blank keeps the
# existing NOT_CONFIGURED behavior. The service pins the file SHA-256 at startup
# and rejects later file drift; changing the pack requires a service restart.
VISIONDATA_OMNI_RULEPACK_PATH=

# Safe default: no external model request.
VISIONDATA_INCIDENT_MODEL_MODE=off

# Supported modes: off | shadow | gated | replay
# shadow calls the model but cannot alter Worker order.
# gated may prioritize only validated, active, allowlisted Workers.
# replay reads a frozen local proposal and makes no external request.

# Operator-supplied OpenAI-compatible gateway. When ENDPOINT is blank, the
# runtime derives https://gw.opentoken.io/v1/chat/completions from BASE_URL.
# Verify the gateway's exact path and model IDs against its own documentation.
VISIONDATA_INCIDENT_MODEL_BASE_URL=https://gw.opentoken.io
VISIONDATA_INCIDENT_MODEL_ENDPOINT=
VISIONDATA_INCIDENT_MODEL_NAME=REPLACE_WITH_PROVIDER_MODEL_ID
VISIONDATA_INCIDENT_MODEL_ALLOWED_HOSTS=gw.opentoken.io
VISIONDATA_INCIDENT_MODEL_ALLOW_REMOTE=false

# Fill only in your local process environment; never commit the real value.
VISIONDATA_INCIDENT_MODEL_API_KEY=

VISIONDATA_INCIDENT_MODEL_TIMEOUT_SECONDS=20
VISIONDATA_INCIDENT_MODEL_MAX_RETRIES=1
VISIONDATA_INCIDENT_MODEL_MAX_RECOMMENDED_WORKERS=4

# Required only when VISIONDATA_INCIDENT_MODEL_MODE=replay.
VISIONDATA_INCIDENT_MODEL_REPLAY_PATH=

# Optional bounded multimodal case advisor. This is separate from the structured
# IncidentModelPlanner above. Safe default: bind image evidence locally but make
# no model request and transmit no image.
VISIONDATA_MULTIMODAL_ADVISOR_MODE=off

# Supported modes: off | gated | replay
# gated requires both the global transmission flag and per-image authorization.
# replay reads a frozen local proposal and never transmits an image.
VISIONDATA_MULTIMODAL_ADVISOR_BASE_URL=https://gw.opentoken.io
VISIONDATA_MULTIMODAL_ADVISOR_ENDPOINT=
VISIONDATA_MULTIMODAL_ADVISOR_MODEL=REPLACE_WITH_PROVIDER_MODEL_ID
VISIONDATA_MULTIMODAL_ADVISOR_ALLOWED_HOSTS=gw.opentoken.io
VISIONDATA_MULTIMODAL_ADVISOR_ALLOW_REMOTE=false
VISIONDATA_MULTIMODAL_ADVISOR_ALLOW_IMAGE_TRANSMISSION=false

# Fill only in the local process environment; never commit a real value.
VISIONDATA_MULTIMODAL_ADVISOR_API_KEY=

VISIONDATA_MULTIMODAL_ADVISOR_TIMEOUT_SECONDS=20
VISIONDATA_MULTIMODAL_ADVISOR_MAX_RETRIES=1

# Required only when VISIONDATA_MULTIMODAL_ADVISOR_MODE=replay.
VISIONDATA_MULTIMODAL_ADVISOR_REPLAY_PATH=

# Optional AgentTeams v1.2.3 Hosted control-plane adapter. AgentTeams does not
# provide a public SaaS endpoint; BASE_URL normally targets a private
# Controller REST service or an explicitly managed tunnel. Safe default: off.
VISIONDATA_AGENTTEAMS_MODE=off
VISIONDATA_AGENTTEAMS_CREDENTIALS_ENABLED=false
VISIONDATA_AGENTTEAMS_BASE_URL=
VISIONDATA_AGENTTEAMS_ALLOWED_HOSTS=
VISIONDATA_AGENTTEAMS_ALLOW_LOCAL=false
VISIONDATA_AGENTTEAMS_TEAM_NAME=visiondata-gate

# Read-only shadow probes never require Matrix. Gated project submission does.
VISIONDATA_AGENTTEAMS_MATRIX_BASE_URL=
VISIONDATA_AGENTTEAMS_MATRIX_ALLOWED_HOSTS=
VISIONDATA_AGENTTEAMS_MATRIX_ALLOW_LOCAL=false
VISIONDATA_AGENTTEAMS_WRITE_ENABLED=false

# Use either a direct value or a file for each credential, never both. Keep
# real values only in the ignored .env.local or process environment.
VISIONDATA_AGENTTEAMS_AUTH_TOKEN=
VISIONDATA_AGENTTEAMS_AUTH_TOKEN_FILE=
VISIONDATA_AGENTTEAMS_MATRIX_ACCESS_TOKEN=
VISIONDATA_AGENTTEAMS_MATRIX_ACCESS_TOKEN_FILE=

VISIONDATA_AGENTTEAMS_TIMEOUT_SECONDS=10
VISIONDATA_AGENTTEAMS_READ_MAX_RETRIES=1
VISIONDATA_AGENTTEAMS_POLL_TIMEOUT_SECONDS=60
VISIONDATA_AGENTTEAMS_POLL_INTERVAL_SECONDS=1
