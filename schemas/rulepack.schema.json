{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visiondata-gate.local/schemas/rulepack.schema.json",
  "title": "VisionData Gate Industrial Rule Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "pack_id", "version", "domain", "intended_use",
    "required_tools", "thresholds", "dynamic_trigger_rules",
    "decision_precedence", "rules", "production_release_allowed_by_default",
    "raw_redistribution_allowed", "final_authority", "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "visiondata-gate.rulepack.v1"},
    "pack_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "domain": {"const": "industrial_visual_data_release"},
    "intended_use": {"const": "sandbox_experiment_training_pool"},
    "required_tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "thresholds": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["integer", "number"]}},
    "dynamic_trigger_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/trigger"}},
    "decision_precedence": {"const": ["INVESTIGATE", "RECAPTURE", "DEFER", "RELEASE"]},
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
    "production_release_allowed_by_default": {"const": false},
    "raw_redistribution_allowed": {"const": false},
    "final_authority": {"const": "responsible_human"},
    "claim_boundary": {"type": "string", "minLength": 20}
  },
  "$defs": {
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger_id", "observed_condition", "worker_capability", "max_cost_units", "on_unavailable"],
      "properties": {
        "trigger_id": {"type": "string"},
        "observed_condition": {"type": "string"},
        "worker_capability": {"type": "string"},
        "max_cost_units": {"type": "integer", "minimum": 1, "maximum": 8},
        "on_unavailable": {"enum": ["DEFER", "INVESTIGATE"]}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "finding_codes", "severity", "action", "human_gate_required", "evidence_requirements", "acceptance_criteria", "safety_boundary"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$"},
        "finding_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        },
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "action": {"enum": ["RECAPTURE", "REMOVE_OR_REPARTITION", "RELABEL", "INVESTIGATE", "QUARANTINE"]},
        "human_gate_required": {"type": "boolean"},
        "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "safety_boundary": {"type": "string", "minLength": 8}
      }
    }
  }
}
