{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visiondata-gate.local/schemas/adapter-manifest.schema.json",
  "title": "VisionData Gate Adapter Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "adapter_id", "adapter_version", "entrypoint",
    "source_kinds", "capabilities", "input_contract_sha256",
    "output_schema_ref", "read_only", "raw_bytes_export_allowed",
    "network_access_required", "timeout_ms", "license_spdx", "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "visiondata-gate.adapter-manifest.v1"},
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entrypoint": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[a-zA-Z_][a-zA-Z0-9_]*$"},
    "source_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "input_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_schema_ref": {"const": "schemas/adapter-observation.schema.json"},
    "read_only": {"const": true},
    "raw_bytes_export_allowed": {"const": false},
    "network_access_required": {"type": "boolean"},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 300000},
    "license_spdx": {"type": "string", "minLength": 2},
    "claim_boundary": {"type": "string", "minLength": 20}
  }
}
