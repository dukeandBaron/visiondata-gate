          "title": "Request Key",
          "type": "string"
        },
        "reviewer_identity": {
          "maxLength": 160,
          "minLength": 2,
          "title": "Reviewer Identity",
          "type": "string"
        },
        "note": {
          "maxLength": 1000,
          "minLength": 8,
