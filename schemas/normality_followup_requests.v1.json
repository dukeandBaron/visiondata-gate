          "type": "string"
        },
        "expected_image_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Image Sha256",
          "type": "string"
        },
        "operator_attests_no_label_or_training_authority": {
          "const": true,
          "title": "Operator Attests No Label Or Training Authority",
          "type": "boolean"
        },
        "operator_attests_import_authorized": {
          "const": true,
          "title": "Operator Attests Import Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "request_key",
        "reviewer_identity",
        "note",
        "expected_feedback_sha256",
        "expected_inference_sha256",
        "expected_asset_sha256",
        "expected_image_sha256",
        "operator_attests_no_label_or_training_authority",
        "operator_attests_import_authorized"
      ],
      "title": "ImportNormalityFollowup",
      "type": "object"
    },
