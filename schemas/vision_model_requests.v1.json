    "CreateVisionTrainingRun": {
      "$defs": {
        "VisionTrainingBudget": {
          "additionalProperties": false,
          "properties": {
            "epochs": {
              "default": 1,
              "maximum": 5,
              "minimum": 1,
              "title": "Epochs",
              "type": "integer"
            },
            "imgsz": {
              "default": 64,
              "maximum": 320,
              "minimum": 64,
              "multipleOf": 32,
              "title": "Imgsz",
              "type": "integer"
            },
            "batch": {
              "default": 2,
              "maximum": 8,
              "minimum": 2,
              "title": "Batch",
              "type": "integer"
            },
            "seed": {
              "default": 0,
              "maximum": 2147483647,
              "minimum": 0,
              "title": "Seed",
              "type": "integer"
            },
            "max_seconds": {
              "default": 120,
              "maximum": 600,
              "minimum": 10,
              "title": "Max Seconds",
              "type": "integer"
            },
            "threads": {
              "default": 2,
              "maximum": 4,
              "minimum": 1,
              "title": "Threads",
              "type": "integer"
            }
          },
          "title": "VisionTrainingBudget",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "request_key": {
          "pattern": "^[A-Za-z0-9_-]{12,100}$",
          "title": "Request Key",
          "type": "string"
        },
        "reviewer_identity": {
          "maxLength": 160,
          "minLength": 2,
          "title": "Reviewer Identity",
          "type": "string"
        },
        "note": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Note",
          "type": "string"
        },
        "runtime_id": {
          "pattern": "^[A-Za-z0-9_-]{1,120}$",
          "title": "Runtime Id",
          "type": "string"
        },
        "expected_runtime_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Runtime Sha256",
          "type": "string"
        },
        "dataset_id": {
          "pattern": "^[A-Za-z0-9_-]{1,120}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "expected_dataset_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Dataset Receipt Sha256",
          "type": "string"
        },
        "initialization": {
          "enum": [
            "ARCHITECTURE_RANDOM",
            "REGISTERED_WEIGHTS"
          ],
          "title": "Initialization",
          "type": "string"
        },
        "initial_model_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,120}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Model Id"
        },
        "expected_weights_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Weights Sha256"
        },
        "architecture": {
          "const": "yolo26n",
          "default": "yolo26n",
          "title": "Architecture",
          "type": "string"
        },
        "training": {
          "$ref": "#/$defs/VisionTrainingBudget"
        },
        "operator_attests_training_authorized": {
          "const": true,
          "title": "Operator Attests Training Authorized",
          "type": "boolean"
        },
        "operator_attests_trusted_runtime": {
          "const": true,
          "title": "Operator Attests Trusted Runtime",
          "type": "boolean"
        },
        "operator_attests_trusted_weights": {
          "default": false,
          "title": "Operator Attests Trusted Weights",
          "type": "boolean"
        },
        "operator_attests_pickle_load_risk": {
          "default": false,
          "title": "Operator Attests Pickle Load Risk",
          "type": "boolean"
        },
        "ultralytics_license_acknowledged": {
          "const": true,
          "title": "Ultralytics License Acknowledged",
          "type": "boolean"
        },
        "adaptation": {
          "const": "OFF",
          "default": "OFF",
          "title": "Adaptation",
          "type": "string"
        },
        "responds_to_feedback_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Responds To Feedback Ids",
          "type": "array"
        },
        "expected_feedback_receipts": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 64,
          "title": "Expected Feedback Receipts",
          "type": "object"
        }
      },
      "required": [
        "request_key",
        "reviewer_identity",
        "note",
        "runtime_id",
        "expected_runtime_sha256",
        "dataset_id",
        "expected_dataset_receipt_sha256",
        "initialization",
        "operator_attests_training_authorized",
        "operator_attests_trusted_runtime",
        "ultralytics_license_acknowledged"
      ],
      "title": "CreateVisionTrainingRun",
      "type": "object"
    },
