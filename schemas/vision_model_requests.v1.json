  "detection_manifest": {
    "$defs": {
      "DetectionBox": {
        "additionalProperties": false,
        "description": "Explicit normalized center-width-height box; no mask conversion.",
        "properties": {
          "class_id": {
            "maximum": 63,
            "minimum": 0,
            "title": "Class Id",
            "type": "integer"
          },
          "x_center": {
            "maximum": 1,
            "minimum": 0,
            "title": "X Center",
            "type": "number"
          },
          "y_center": {
            "maximum": 1,
            "minimum": 0,
            "title": "Y Center",
            "type": "number"
          },
          "width": {
            "exclusiveMinimum": 0,
            "maximum": 1,
            "title": "Width",
            "type": "number"
          },
          "height": {
            "exclusiveMinimum": 0,
            "maximum": 1,
            "title": "Height",
            "type": "number"
          }
        },
        "required": [
          "class_id",
          "x_center",
          "y_center",
          "width",
          "height"
        ],
        "title": "DetectionBox",
        "type": "object"
      },
      "DetectionSample": {
        "additionalProperties": false,
        "properties": {
          "sample_id": {
            "maxLength": 96,
            "minLength": 1,
            "title": "Sample Id",
            "type": "string"
          },
          "image_path": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Image Path",
            "type": "string"
          },
          "image_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Image Sha256",
            "type": "string"
          },
          "split": {
            "enum": [
              "train",
              "val",
              "test"
            ],
            "title": "Split",
            "type": "string"
          },
          "group_id": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Group Id",
            "type": "string"
          },
          "annotation_revision": {
            "maximum": 2147483647,
            "minimum": 0,
            "title": "Annotation Revision",
            "type": "integer"
          },
          "boxes": {
            "items": {
              "$ref": "#/$defs/DetectionBox"
            },
            "maxItems": 256,
            "title": "Boxes",
            "type": "array"
          },
          "reviewer_name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Reviewer Name",
            "type": "string"
          },
          "reviewed": {
            "title": "Reviewed",
            "type": "boolean"
          },
          "normal_attested": {
            "default": false,
            "title": "Normal Attested",
            "type": "boolean"
          }
        },
        "required": [
          "sample_id",
          "image_path",
          "image_sha256",
          "split",
          "group_id",
          "annotation_revision",
          "boxes",
          "reviewer_name",
          "reviewed"
        ],
        "title": "DetectionSample",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "visiondata-gate.detection-dataset.v1",
        "title": "Schema Version",
        "type": "string"
      },
      "class_names": {
        "items": {
          "type": "string"
        },
        "maxItems": 64,
        "minItems": 1,
        "title": "Class Names",
        "type": "array"
      },
      "source_version": {
        "maxLength": 160,
        "minLength": 1,
        "title": "Source Version",
        "type": "string"
      },
      "samples": {
        "items": {
          "$ref": "#/$defs/DetectionSample"
        },
        "maxItems": 64,
        "minItems": 3,
        "title": "Samples",
        "type": "array"
      }
    },
    "required": [
      "schema_version",
      "class_names",
      "source_version",
      "samples"
    ],
    "title": "DetectionDatasetManifest",
    "type": "object"
  }
}
