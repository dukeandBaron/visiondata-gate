    "ReviewNormalityInference": {
      "additionalProperties": false,
      "properties": {
        "request_key": {
          "pattern": "^[A-Za-z0-9_-]{12,100}$",
          "title": "Request Key",
          "type": "string"
        },
        "reviewer_identity": {
          "maxLength": 160,
          "minLength": 2,
          "title": "Reviewer Identity",
          "type": "string"
        },
        "note": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Note",
          "type": "string"
        },
        "expected_inference_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Inference Sha256",
          "type": "string"
        },
        "operator_attests_reviewed": {
          "const": true,
          "title": "Operator Attests Reviewed",
          "type": "boolean"
        },
        "classification": {
          "enum": [
            "MODEL_SIGNAL_CONFIRMED",
            "LIKELY_FALSE_POSITIVE",
            "NEEDS_LABEL_REVIEW",
            "INSUFFICIENT_EVIDENCE"
          ],
          "title": "Classification",
          "type": "string"
        }
      },
      "required": [
        "request_key",
        "reviewer_identity",
        "note",
        "expected_inference_sha256",
        "operator_attests_reviewed",
        "classification"
      ],
      "title": "ReviewNormalityInference",
      "type": "object"
    },
