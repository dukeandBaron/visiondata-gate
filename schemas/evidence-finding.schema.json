{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visiondata-gate.local/schemas/evidence-finding.schema.json",
  "title": "VisionData Gate Evidence Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "tool",
    "code",
    "severity",
    "summary",
    "redacted_sample_ids",
    "evidence_span",
    "reason_trace",
    "source_refs",
    "result_sha256",
    "recommended_action"
  ],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "code": {"type": "string", "minLength": 1},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "summary": {"type": "string", "minLength": 1},
    "redacted_sample_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_span": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reason_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recommended_action": {"type": "string", "minLength": 1}
  }
}
