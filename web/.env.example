# Browser-visible local service locations only. Never put API keys or secrets
# in a VITE_* variable because Vite embeds those values in the client bundle.
VITE_VISIONDATA_API_BASE_URL=http://127.0.0.1:8787
VITE_VISIONDATA_REVIEWER_BASE_URL=http://127.0.0.1:8765
# Local prototype actor only; this is not enterprise IAM or an authentication secret.
VITE_VISIONDATA_ACTOR_USER_ID=usr_local_demo
